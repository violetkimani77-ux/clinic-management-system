generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum RoleCode {
  ADMIN
  PHARMACY
  ACCOUNTS
}

enum VisitStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PrescriptionStatus {
  CREATED
  SENT_TO_PHARMACY
  PROCESSING
  PARTIALLY_DISPENSED
  DISPENSED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  MPESA
  CARD
  BANK
  OTHER
}

enum PaymentStatus {
  PENDING
  VERIFIED
  FAILED
  REVERSED
}

enum StockMovementType {
  PURCHASE
  DISPENSE
  ADJUSTMENT
  RETURN
  EXPIRY
  DISPOSAL
}

model Clinic {
  id String @id @default(uuid())
  name String
  code String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
  patients Patient[]
  medicines Medicine[]
  batches StockBatch[]
  visits Visit[]
  prescriptions Prescription[]
  invoices Invoice[]
  payments Payment[]
  expenses Expense[]
  auditLogs AuditLog[]
  sessions AuthSession[]
  stockMovements StockMovement[]
  dispensings Dispensing[]
}

model User {
  id String @id @default(uuid())
  email String @unique
  name String
  passwordHash String
  status UserStatus @default(INVITED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
  auditLogs AuditLog[]
  sessions AuthSession[]
  dispensing Dispensing[]
}

model AuthSession {
  id String @id @default(uuid())
  tokenHash String @unique
  userId String
  clinicId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  @@index([userId, expiresAt])
  @@index([clinicId, expiresAt])
}

model Role {
  id String @id @default(uuid())
  code RoleCode @unique
  name String
  memberships Membership[]
  permissions RolePermission[]
}

model Permission {
  id String @id @default(uuid())
  code String @unique
  description String
  roles RolePermission[]
}

model Membership {
  id String @id @default(uuid())
  clinicId String
  userId String
  roleId String
  createdAt DateTime @default(now())
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)
  @@unique([clinicId, userId])
  @@index([userId])
}

model RolePermission {
  roleId String
  permissionId String
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model Patient {
  id String @id @default(uuid())
  clinicId String
  patientNo String
  firstName String
  lastName String
  dateOfBirth DateTime?
  phone String?
  email String?
  address String?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archivedAt DateTime?
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  visits Visit[]
  prescriptions Prescription[]
  invoices Invoice[]
  payments Payment[]
  @@unique([clinicId, patientNo])
  @@index([clinicId, lastName, firstName])
  @@index([clinicId, phone])
}

model Visit {
  id String @id @default(uuid())
  clinicId String
  patientId String
  status VisitStatus @default(OPEN)
  openedAt DateTime @default(now())
  closedAt DateTime?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  prescriptions Prescription[]
  invoices Invoice[]
  @@index([clinicId, patientId, openedAt])
  @@index([clinicId, status])
}

model Prescription {
  id String @id @default(uuid())
  clinicId String
  patientId String
  visitId String?
  status PrescriptionStatus @default(CREATED)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cancelledAt DateTime?
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  visit Visit? @relation(fields: [visitId], references: [id], onDelete: Restrict)
  items PrescriptionItem[]
  dispensing Dispensing[]
  @@index([clinicId, status])
  @@index([patientId, createdAt])
}

model PrescriptionItem {
  id String @id @default(uuid())
  prescriptionId String
  medicineId String
  quantity Int
  dosage String?
  frequency String?
  duration String?
  instructions String?
  createdAt DateTime @default(now())
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Restrict)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  @@index([prescriptionId])
}

model Medicine {
  id String @id @default(uuid())
  clinicId String
  name String
  strength String?
  form String?
  reorderLevel Int @default(0)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  batches StockBatch[]
  prescriptionItems PrescriptionItem[]
  @@index([clinicId, name])
}

model StockBatch {
  id String @id @default(uuid())
  clinicId String
  medicineId String
  batchNumber String
  expiryDate DateTime
  quantity Int
  unitCost Decimal @db.Decimal(12, 2)
  sellingPrice Decimal @db.Decimal(12, 2)
  supplierName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  movements StockMovement[]
  dispensingItems DispensingItem[]
  @@unique([clinicId, medicineId, batchNumber])
  @@index([clinicId, medicineId, expiryDate])
}

model StockMovement {
  id String @id @default(uuid())
  clinicId String
  batchId String
  type StockMovementType
  quantity Int
  referenceId String?
  reason String?
  createdAt DateTime @default(now())
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  batch StockBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  @@index([clinicId, batchId, createdAt])
}

model Dispensing {
  id String @id @default(uuid())
  clinicId String
  prescriptionId String
  createdAt DateTime @default(now())
  dispensedById String?
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Restrict)
  dispensedBy User? @relation(fields: [dispensedById], references: [id], onDelete: Restrict)
  items DispensingItem[]
  invoiceItem InvoiceItem?
  @@index([clinicId, createdAt])
}

model DispensingItem {
  id String @id @default(uuid())
  dispensingId String
  batchId String
  quantity Int
  dispensing Dispensing @relation(fields: [dispensingId], references: [id], onDelete: Restrict)
  batch StockBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  @@index([dispensingId])
}

model Invoice {
  id String @id @default(uuid())
  clinicId String
  patientId String
  visitId String?
  invoiceNo String
  status InvoiceStatus @default(DRAFT)
  total Decimal @db.Decimal(12, 2)
  amountPaid Decimal @default(0) @db.Decimal(12, 2)
  issuedAt DateTime?
  voidedAt DateTime?
  voidedById String?
  voidReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  visit Visit? @relation(fields: [visitId], references: [id], onDelete: Restrict)
  items InvoiceItem[]
  payments Payment[]
  @@unique([clinicId, invoiceNo])
  @@index([clinicId, status])
}

model InvoiceItem {
  id String @id @default(uuid())
  invoiceId String
  dispensingId String? @unique
  description String
  quantity Int @default(1)
  unitPrice Decimal @db.Decimal(12, 2)
  total Decimal @db.Decimal(12, 2)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  dispensing Dispensing? @relation(fields: [dispensingId], references: [id], onDelete: Restrict)
}

model Payment {
  id String @id @default(uuid())
  clinicId String
  patientId String
  invoiceId String?
  amount Decimal @db.Decimal(12, 2)
  method PaymentMethod
  status PaymentStatus @default(PENDING)
  externalRef String?
  receiptNo String?
  idempotencyKey String
  receivedAt DateTime?
  createdAt DateTime @default(now())
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  @@unique([clinicId, idempotencyKey])
  @@unique([clinicId, externalRef])
  @@unique([clinicId, receiptNo])
  @@index([clinicId, method, createdAt])
}

model Expense {
  id String @id @default(uuid())
  clinicId String
  description String
  amount Decimal @db.Decimal(12, 2)
  expenseDate DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  @@index([clinicId, expenseDate])
}

model AuditLog {
  id String @id @default(uuid())
  clinicId String
  userId String?
  action String
  entityType String
  entityId String?
  metadata Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([clinicId, createdAt])
  @@index([clinicId, entityType, entityId])
  @@index([userId, createdAt])
}
